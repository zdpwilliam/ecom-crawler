{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "server/**/*.ts",
    "scripts/**/*.ts",
    "tools/*.ts",
    "src/ui/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "data",
    ".git"
  ]
}
